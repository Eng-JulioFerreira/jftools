<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{B8F3A1C2-7D4E-4A9B-8C6D-1E2F3A4B5C6D}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>JFTools</RootNamespace>
    <AssemblyName>JFTools</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- ═══ AJUSTE AQUI: caminho do seu Revit ═══ -->
  <PropertyGroup>
    <RevitApiPath>D:\Autodesk\Programas\Revit 2023</RevitApiPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EPPlus">
      <HintPath>..\packages\EPPlus.4.5.3\lib\net40\EPPlus.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="JFToolsApp.cs" />
    <Compile Include="ExportSheetsCommand.cs" />
    <Compile Include="Models\SheetItem.cs" />
    <Compile Include="Helpers\L.cs" />
    <Compile Include="Helpers\NamingHelper.cs" />
    <Compile Include="Helpers\ExportHelper.cs" />
    <Compile Include="Helpers\ExportSettingsHelper.cs" />
    <Compile Include="Helpers\OleImageBinder.cs" />
    <Compile Include="Views\MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="Views\RevisionEditorDialog.xaml.cs">
      <DependentUpon>RevisionEditorDialog.xaml</DependentUpon>
    </Compile>
    <Compile Include="Commands\ExcelCommand.cs" />
    <Compile Include="Helpers\ExcelHelper.cs" />
    <Compile Include="Views\ExcelDialog.xaml.cs">
      <DependentUpon>ExcelDialog.xaml</DependentUpon>
    </Compile>
    <Compile Include="Views\NamingProfileEditorDialog.xaml.cs">
      <DependentUpon>NamingProfileEditorDialog.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Include="Views\MainWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\RevisionEditorDialog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\ExcelDialog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\NamingProfileEditorDialog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon16.png" />
    <EmbeddedResource Include="Resources\icon32.png" />
    <EmbeddedResource Include="Resources\impressora.png" />
    <EmbeddedResource Include="Resources\folhas-do-google.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\JFTools.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="packages.config" />
    <None Include="export_profiles.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
