<Window x:Class="JFTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:JFTools.Helpers"
        Title="{x:Static l:L.MainTitle}" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="White">

    <Window.Resources>

        <!-- ── Primary Button ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1557B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#C5D8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab Control ── -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FFFFFF"
                                    BorderBrush="#DDE1E7" BorderThickness="0,0,0,1">
                                <TabPanel Name="HeaderPanel" IsItemsHost="True"
                                          Background="Transparent" Margin="6,0"/>
                            </Border>
                            <ContentPresenter Name="PART_SelectedContentHost"
                                              Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab Item ── -->
        <Style TargetType="TabItem">
            <Setter Property="Padding"         Value="18,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter x:Name="txt" ContentSource="Header"
                                              TextElement.Foreground="#80868B"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd"  Property="BorderBrush"           Value="#1A73E8"/>
                                <Setter TargetName="txt" Property="TextElement.Foreground" Value="#1A73E8"/>
                                <Setter TargetName="txt" Property="TextElement.FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="txt" Property="TextElement.Foreground" Value="#333333"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Progress Bar ── -->
        <Style x:Key="BluePB" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="#E8EAED" BorderBrush="#C8CDD4"
                                BorderThickness="1" CornerRadius="4">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="#1A73E8" CornerRadius="3" Margin="1"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
    <!-- Export profile selector — floats on the tab header bar (right-aligned) -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right"
                Height="38" Margin="0,0,8,0" Panel.ZIndex="10">
        <ComboBox x:Name="comboExportProfile" Width="170" Height="26" FontSize="11"
                  VerticalAlignment="Center"
                  SelectionChanged="OnExportProfileSelectionChanged"
                  ToolTip="{x:Static l:L.GrpExportProfile}"/>
        <Button x:Name="btnSaveExportProfile" Width="28" Height="26" FontSize="13"
                Margin="4,0,0,0" VerticalAlignment="Center"
                ToolTip="{x:Static l:L.TipSaveExportProfile}"
                Click="OnSaveExportProfile">
            <TextBlock Text="💾" FontSize="13"/>
        </Button>
        <Button x:Name="btnEditExportProfiles" Width="28" Height="26" FontSize="13"
                Margin="3,0,0,0" VerticalAlignment="Center"
                ToolTip="{x:Static l:L.TipEditExportProfiles}"
                Click="OnEditExportProfiles">
            <TextBlock Text="✎" FontSize="14"/>
        </Button>
    </StackPanel>

    <TabControl Background="White">
        <!-- TAB 1 — SELECTION -->
        <TabItem Header="{x:Static l:L.TabSelection}">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search + actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="txtFilter" Height="30" Padding="28,0,8,0"
                                 VerticalContentAlignment="Center" TextChanged="OnFilterChanged"/>
                        <TextBlock x:Name="txtFilterPlaceholder"
                                   Text="{x:Static l:L.SearchPlaceholder}"
                                   Foreground="#AAAAAA" FontStyle="Italic" FontSize="11"
                                   VerticalAlignment="Center" Margin="30,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="&#x1F50D;" FontSize="12" Opacity="0.4"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="8,1,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <ComboBox x:Name="comboProjectFilter" Grid.Column="2" Height="30"
                              SelectionChanged="OnProjectFilterChanged"/>
                    <Button x:Name="btnSelectAll" Grid.Column="4" Content="{x:Static l:L.BtnSelectAll}"
                            Width="120" Height="30" Click="OnSelectAll"/>
                    <Button x:Name="btnDeselectAll" Grid.Column="6" Content="{x:Static l:L.BtnDeselectAll}"
                            Width="116" Height="30" Click="OnDeselectAll"/>
                    <Button x:Name="btnAddRevision" Grid.Column="8" Content="{x:Static l:L.BtnAddRevision}"
                            Height="30" Width="134"
                            Background="#1A73E8" BorderThickness="0"
                            Foreground="White" FontWeight="SemiBold" FontSize="11"
                            Click="OnAddRevision"/>
                    <Border Grid.Column="10" Background="#E8F0FE" BorderBrush="#C5D8F8"
                            BorderThickness="1" CornerRadius="4" Padding="10,0" Height="30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="lblCount" Text="0" Foreground="#1A73E8"
                                       FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{x:Static l:L.LblSelected}" Foreground="#80868B" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Projects strip -->
                <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#DDE1E7"
                        BorderThickness="1" CornerRadius="4" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static l:L.LblProjects}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#5F6368" VerticalAlignment="Top" Margin="0,4,10,0"/>
                        <ItemsControl x:Name="lstProjects" Grid.Column="1">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F0FE" BorderBrush="#C5D8F8"
                                            BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,2,6,2">
                                        <TextBlock Text="{Binding}" Foreground="#1A73E8" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="btnAddProject" Grid.Column="3" Content="{x:Static l:L.BtnAddProject}"
                                Width="96" Height="28" FontSize="11" Click="OnAddProject"/>
                        <Button x:Name="btnRemoveProject" Grid.Column="5" Content="{x:Static l:L.BtnRemoveProject}"
                                Width="86" Height="28" FontSize="11" IsEnabled="False" Click="OnRemoveProject"/>
                    </Grid>
                </Border>

                <!-- Sheet list -->
                <ListView x:Name="sheetList" Grid.Row="4" SelectionMode="Extended"
                          BorderBrush="#DDE1E7" BorderThickness="1"
                          GridViewColumnHeader.Click="OnColumnHeaderClick"
                          PreviewMouseLeftButtonDown="OnSheetListMouseDown">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="44">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Focusable="False"
                                                  Checked="OnSheetCheckedChanged" Unchecked="OnSheetCheckedChanged"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static l:L.ColNumberAsc}" DisplayMemberBinding="{Binding Number}" Width="100"/>
                            <GridViewColumn Header="{x:Static l:L.ColSheetName}" DisplayMemberBinding="{Binding Name}" Width="210"/>
                            <GridViewColumn Header="{x:Static l:L.ColProject}" DisplayMemberBinding="{Binding DocTitle}" Width="130"/>
                            <GridViewColumn Header="{x:Static l:L.ColRev}" DisplayMemberBinding="{Binding Revision}" Width="55"/>
                            <GridViewColumn Header="{x:Static l:L.ColRevDate}" DisplayMemberBinding="{Binding RevisionDate}" Width="90"/>
                            <GridViewColumn Header="{x:Static l:L.ColDescription}" DisplayMemberBinding="{Binding RevisionDescription}" Width="180"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

        <!-- TAB 2 — EXPORT OPTIONS -->
        <TabItem Header="{x:Static l:L.TabExportOpts}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Format Card Selector -->
                <Border BorderBrush="#DDE1E7" BorderThickness="0,0,0,1" Background="#FAFAFA" Padding="14,10">
                    <StackPanel Orientation="Horizontal">

                        <!-- PDF Card -->
                        <Border x:Name="cardPDF" Width="120" Height="52" CornerRadius="6" Cursor="Hand"
                                BorderBrush="#1A73E8" BorderThickness="2" Background="#E8F0FE"
                                PreviewMouseLeftButtonDown="OnCardPDFClick">
                            <Grid Margin="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblCardPDF" Text="PDF" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#1A73E8" VerticalAlignment="Center"/>
                                <CheckBox x:Name="chkPDF" Grid.Column="1" IsChecked="True"
                                          VerticalAlignment="Center"
                                          Checked="OnFormatChanged" Unchecked="OnFormatChanged"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static l:L.PerSheet}"
                                           FontSize="10" Foreground="#5F6368"/>
                            </Grid>
                        </Border>

                        <Border Width="8"/>

                        <!-- DWG Card -->
                        <Border x:Name="cardDWG" Width="120" Height="52" CornerRadius="6" Cursor="Hand"
                                BorderBrush="#DDE1E7" BorderThickness="1" Background="White"
                                PreviewMouseLeftButtonDown="OnCardDWGClick">
                            <Grid Margin="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblCardDWG" Text="DWG" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#3C4043" VerticalAlignment="Center"/>
                                <CheckBox x:Name="chkDWG" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="OnFormatChanged" Unchecked="OnFormatChanged"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static l:L.PerSheet}"
                                           FontSize="10" Foreground="#5F6368"/>
                            </Grid>
                        </Border>

                        <Border Width="8"/>

                        <!-- IFC Card -->
                        <Border x:Name="cardIFC" Width="120" Height="52" CornerRadius="6" Cursor="Hand"
                                BorderBrush="#DDE1E7" BorderThickness="1" Background="White"
                                PreviewMouseLeftButtonDown="OnCardIFCClick">
                            <Grid Margin="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblCardIFC" Text="IFC" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#3C4043" VerticalAlignment="Center"/>
                                <CheckBox x:Name="chkIFC" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="OnFormatChanged" Unchecked="OnFormatChanged"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static l:L.PerProject}"
                                           FontSize="10" Foreground="#5F6368"/>
                            </Grid>
                        </Border>

                        <Border Width="8"/>

                        <!-- NWC Card -->
                        <Border x:Name="cardNWC" Width="120" Height="52" CornerRadius="6" Cursor="Hand"
                                BorderBrush="#DDE1E7" BorderThickness="1" Background="White"
                                PreviewMouseLeftButtonDown="OnCardNWCClick">
                            <Grid Margin="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblCardNWC" Text="NWC" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#3C4043" VerticalAlignment="Center"/>
                                <CheckBox x:Name="chkNWC" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Checked="OnFormatChanged" Unchecked="OnFormatChanged"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static l:L.PerProject}"
                                           FontSize="10" Foreground="#5F6368"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Content Panels (stacked, one visible at a time) -->
                <Grid Grid.Row="1">

                    <!-- PDF Panel -->
                    <Grid x:Name="panelPDF" Margin="14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Static l:L.LblHiddenLines}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2">
                            <RadioButton x:Name="radioVector" Content="{x:Static l:L.RadioVector}" IsChecked="True" Margin="0,0,0,4"/>
                            <RadioButton x:Name="radioRaster" Content="{x:Static l:L.RadioRaster}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{x:Static l:L.LblRasterQuality}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox x:Name="comboQuality" Grid.Row="2" Grid.Column="2" Height="26"/>

                        <TextBlock Grid.Row="4" Text="{x:Static l:L.LblColorMode}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox x:Name="comboColorMode" Grid.Row="4" Grid.Column="2" Height="26"/>

                        <TextBlock Grid.Row="6" Text="{x:Static l:L.LblHide}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Top" Margin="0,3,0,0"/>
                        <StackPanel Grid.Row="6" Grid.Column="2">
                            <CheckBox x:Name="chkRef" Content="{x:Static l:L.ChkRef}" Margin="0,0,0,4"/>
                            <CheckBox x:Name="chkTags" Content="{x:Static l:L.ChkTags}" Margin="0,0,0,4"/>
                            <CheckBox x:Name="chkScope" Content="{x:Static l:L.ChkScope}" Margin="0,0,0,4"/>
                            <CheckBox x:Name="chkCrop" Content="{x:Static l:L.ChkCrop}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="8" Text="{x:Static l:L.LblOutputPdf}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                        <CheckBox x:Name="chkPDFSingle" Grid.Row="8" Grid.Column="2"
                                  Content="{x:Static l:L.ChkCombinePdf}"
                                  Checked="OnPdfSingleChanged" Unchecked="OnPdfSingleChanged"/>

                        <TextBlock x:Name="lblPdfSingleName" Grid.Row="10" Text="{x:Static l:L.LblFilename}"
                                   Foreground="#5F6368" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBox x:Name="txtPdfSingleName" Grid.Row="10" Grid.Column="2"
                                 Height="26" Text="{x:Static l:L.DefaultPdfName}" Visibility="Collapsed"
                                 VerticalContentAlignment="Center" Padding="4,0"/>
                    </Grid>

                    <!-- DWG Panel -->
                    <ScrollViewer x:Name="panelDWG" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,10,14,12">

                            <!-- Setup selector row -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static l:L.LblExportSetup}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox x:Name="comboDWG" Grid.Column="2" Height="26"
                                          SelectionChanged="OnDwgSetupSelectionChanged"/>
                                <Button x:Name="btnDWGPerProject" Grid.Column="4" Height="26"
                                        Content="{x:Static l:L.BtnPerProject}" Padding="10,0" FontSize="11"
                                        IsEnabled="False" Click="OnDwgPerProject"
                                        ToolTip="{x:Static l:L.DwgPerProjTip}"/>
                            </Grid>

                            <!-- OLE binding — always available, even with multiple projects -->
                            <CheckBox x:Name="chkBindOle" Margin="0,0,0,8"
                                      ToolTip="{x:Static l:L.BindOleTip}" FontSize="11">
                                <TextBlock Text="{x:Static l:L.ChkBindOle}" FontSize="11" TextWrapping="Wrap"/>
                            </CheckBox>

                            <!-- Settings area — disabled when multiple projects are loaded -->
                            <StackPanel x:Name="pnlDwgSettingsArea">

                            <!-- Two-column layout -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ═══ LEFT COLUMN — General ═══ -->
                                <GroupBox Grid.Column="0" Header="{x:Static l:L.GrpDwgGeneral}" FontSize="11">
                                    <StackPanel Margin="8,4,8,6">

                                        <!-- AutoCAD file version -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static l:L.LblDwgVersion}" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="#5F6368"/>
                                            <ComboBox x:Name="comboDwgVersion" Grid.Column="2" Height="24" FontSize="11"/>
                                        </Grid>

                                        <Separator Margin="0,2,0,5" Background="#E0E0E0"/>

                                        <!-- Export views as XREF -->
                                        <CheckBox x:Name="chkDwgViewXRef" FontSize="11" Margin="0,0,0,5">
                                            <TextBlock Text="{x:Static l:L.ChkDwgViewXRef}"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                        </CheckBox>

                                        <Separator Margin="0,2,0,5" Background="#E0E0E0"/>

                                        <!-- Checkboxes -->
                                        <CheckBox x:Name="chkDwgAreas"      Content="{x:Static l:L.ChkDwgAreas}"      FontSize="11" Margin="0,1,0,1"/>
                                        <CheckBox x:Name="chkDwgCoincident" Content="{x:Static l:L.ChkDwgCoincident}" FontSize="11" Margin="0,1,0,1"/>
                                        <CheckBox x:Name="chkDwgNonplot"    Content="{x:Static l:L.ChkDwgNonplot}"    FontSize="11" Margin="0,1,0,1"/>
                                        <CheckBox x:Name="chkDwgHideRef"    Content="{x:Static l:L.ChkDwgHideRef}"    FontSize="11" Margin="0,1,0,1"/>
                                        <CheckBox x:Name="chkDwgHideScope"  Content="{x:Static l:L.ChkDwgHideScope}"  FontSize="11" Margin="0,1,0,1"/>
                                        <CheckBox x:Name="chkDwgHideTags"   Content="{x:Static l:L.ChkDwgHideTags}"   FontSize="11" Margin="0,1,0,5"/>

                                        <Separator Margin="0,2,0,5" Background="#E0E0E0"/>

                                        <!-- Non-plot suffix -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static l:L.LblDwgNonplotSuffix}" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="#5F6368"/>
                                            <TextBox x:Name="txtDwgNonplotSuffix" Grid.Column="2" Height="24"
                                                     FontSize="11" Padding="4,0" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- ACA Objects -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static l:L.LblDwgACA}" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="#5F6368"/>
                                            <ComboBox x:Name="comboDwgACA" Grid.Column="2" Height="24" FontSize="11"/>
                                        </Grid>

                                        <!-- Layer property overrides -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static l:L.LblDwgPropOverrides}" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="#5F6368"/>
                                            <ComboBox x:Name="comboDwgPropOverrides" Grid.Column="2" Height="24" FontSize="11"/>
                                        </Grid>

                                    </StackPanel>
                                </GroupBox>

                                <!-- ═══ RIGHT COLUMN — smaller sections ═══ -->
                                <StackPanel Grid.Column="2">

                                    <!-- Colors -->
                                    <GroupBox Header="{x:Static l:L.GrpDwgColors}" FontSize="11" Margin="0,0,0,6">
                                        <StackPanel Margin="8,4,8,4">
                                            <RadioButton x:Name="radioDwgColorTrue"    GroupName="DwgColor"
                                                         Content="{x:Static l:L.RadDwgColorTrue}"
                                                         FontSize="11" IsChecked="True" Margin="0,1,0,1"/>
                                            <RadioButton x:Name="radioDwgColorIndex"   GroupName="DwgColor"
                                                         Content="{x:Static l:L.RadDwgColorIndex}"
                                                         FontSize="11" Margin="0,1,0,1"/>
                                            <RadioButton x:Name="radioDwgColorPerView" GroupName="DwgColor"
                                                         Content="{x:Static l:L.RadDwgColorPerView}"
                                                         FontSize="11" Margin="0,1,0,1"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- Text and Fonts -->
                                    <GroupBox Header="{x:Static l:L.GrpDwgTextFonts}" FontSize="11" Margin="0,0,0,6">
                                        <StackPanel Margin="8,4,8,4">
                                            <RadioButton x:Name="radioDwgTextExact"  GroupName="DwgText"
                                                         Content="{x:Static l:L.RadDwgTextExact}"
                                                         FontSize="11" IsChecked="True" Margin="0,1,0,1"/>
                                            <RadioButton x:Name="radioDwgTextApprox" GroupName="DwgText"
                                                         Content="{x:Static l:L.RadDwgTextApprox}"
                                                         FontSize="11" Margin="0,1,0,1"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- Solids -->
                                    <GroupBox Header="{x:Static l:L.GrpDwgSolids}" FontSize="11" Margin="0,0,0,6">
                                        <StackPanel Margin="8,4,8,4">
                                            <RadioButton x:Name="radioDwgSolidsPolymesh" GroupName="DwgSolids"
                                                         Content="{x:Static l:L.RadDwgSolidsPolymesh}"
                                                         FontSize="11" IsChecked="True" Margin="0,1,0,1"/>
                                            <RadioButton x:Name="radioDwgSolidsACIS"     GroupName="DwgSolids"
                                                         Content="{x:Static l:L.RadDwgSolidsACIS}"
                                                         FontSize="11" Margin="0,1,0,1"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- Units and Coordinates -->
                                    <GroupBox Header="{x:Static l:L.GrpDwgUnitsCoords}" FontSize="11" Margin="0,0,0,6">
                                        <StackPanel Margin="8,4,8,4">
                                            <!-- Units combo -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Static l:L.LblDwgUnits}" FontSize="11"
                                                           VerticalAlignment="Center" Foreground="#5F6368"/>
                                                <ComboBox x:Name="comboDwgUnits" Grid.Column="2" Height="24" FontSize="11"/>
                                            </Grid>
                                            <!-- Coordinate system -->
                                            <RadioButton x:Name="radioDwgCoordProject" GroupName="DwgCoord"
                                                         Content="{x:Static l:L.RadDwgCoordProject}"
                                                         FontSize="11" IsChecked="True" Margin="0,1,0,1"/>
                                            <RadioButton x:Name="radioDwgCoordShared"  GroupName="DwgCoord"
                                                         Content="{x:Static l:L.RadDwgCoordShared}"
                                                         FontSize="11" Margin="0,1,0,1"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- Lines -->
                                    <GroupBox Header="{x:Static l:L.GrpDwgLines}" FontSize="11" Margin="0,0,0,6">
                                        <StackPanel Margin="8,4,8,4">
                                            <RadioButton x:Name="radioDwgLineViewScale" GroupName="DwgLine"
                                                         Content="{x:Static l:L.RadDwgLineViewScale}"
                                                         FontSize="11" IsChecked="True" Margin="0,1,0,1"/>
                                            <RadioButton x:Name="radioDwgLineModel"     GroupName="DwgLine"
                                                         Content="{x:Static l:L.RadDwgLineModel}"
                                                         FontSize="11" Margin="0,1,0,1"/>
                                            <RadioButton x:Name="radioDwgLinePaper"     GroupName="DwgLine"
                                                         Content="{x:Static l:L.RadDwgLinePaper}"
                                                         FontSize="11" Margin="0,1,0,1"/>
                                        </StackPanel>
                                    </GroupBox>

                                </StackPanel>
                            </Grid>

                            </StackPanel><!-- /pnlDwgSettingsArea -->

                        </StackPanel>
                    </ScrollViewer>

                    <!-- NWC Panel (2 tabs: Basic Settings / Advanced) -->
                    <TabControl x:Name="tabNWC" Visibility="Collapsed" Background="White">

                        <!-- ── Basic Settings ── -->
                        <TabItem Header="{x:Static l:L.TabNwcBasic}">
                            <Grid Margin="14,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Static l:L.LblCoordinates}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox x:Name="comboNwcCoords" Grid.Column="2" Height="26"/>

                                <TextBlock Grid.Row="2" Text="{x:Static l:L.LblNwcParams}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox x:Name="comboNwcParams" Grid.Row="2" Grid.Column="2" Height="26"/>

                                <CheckBox x:Name="chkNwcLinks"        Grid.Row="4" Grid.ColumnSpan="3" Content="{x:Static l:L.ChkNwcLinks}" FontSize="11"/>
                                <CheckBox x:Name="chkNwcConvertProps"  Grid.Row="6" Grid.ColumnSpan="3" Content="{x:Static l:L.ChkNwcConvertProps}" FontSize="11" IsChecked="True"/>
                                <CheckBox x:Name="chkNwcDivide"       Grid.Row="8" Grid.ColumnSpan="3" Content="{x:Static l:L.ChkNwcDivide}" FontSize="11"/>
                            </Grid>
                        </TabItem>

                        <!-- ── Advanced ── -->
                        <TabItem Header="{x:Static l:L.TabNwcAdvanced}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,12" Orientation="Vertical">

                                    <!-- Faceting Factor -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static l:L.LblFacetingFactor}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtNwcFaceting" Grid.Column="2" Height="26" Text="1.0"
                                                 VerticalContentAlignment="Center" Padding="4,0"/>
                                    </Grid>

                                    <!-- Option checkboxes -->
                                    <CheckBox x:Name="chkNwcUrls"       Content="{x:Static l:L.ChkNwcUrls}"       FontSize="11" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="chkNwcMissingMat" Content="{x:Static l:L.ChkNwcMissingMat}" FontSize="11" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="chkNwcRoomAttr"   Content="{x:Static l:L.ChkNwcRoomAttr}"   FontSize="11" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="chkNwcRoomGeom"   Content="{x:Static l:L.ChkNwcRoomGeom}"   FontSize="11" Margin="0,0,0,14"/>

                                    <!-- Import / Save settings -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnImportNwcSettings" Content="{x:Static l:L.BtnImportNwcSettings}"
                                                Width="140" Height="28" Margin="0,0,8,0"
                                                Click="OnImportNwcSettings"/>
                                        <Button x:Name="btnSaveNwcSettings" Content="{x:Static l:L.BtnSaveNwcSettings}"
                                                Width="140" Height="28"
                                                Click="OnSaveNwcSettings"/>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>

                    <!-- IFC Panel (2 tabs: Basic Settings / Advanced) -->
                    <TabControl x:Name="tabIFC" Visibility="Collapsed" Background="White">

                        <!-- ── Basic Settings ── -->
                        <TabItem Header="{x:Static l:L.TabIfcBasic}">
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: General + Additional Content -->
                                <StackPanel Grid.Column="0">

                                    <GroupBox Header="{x:Static l:L.GrpGeneral}" Padding="8,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{x:Static l:L.LblIfcVersion}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="comboIfcVersion" Grid.Column="2" Height="26"/>

                                            <TextBlock Grid.Row="2" Text="{x:Static l:L.LblFileType}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="comboIfcFileType" Grid.Row="2" Grid.Column="2" Height="26"/>

                                            <TextBlock Grid.Row="4" Text="{x:Static l:L.LblSpaceBound}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="comboIfcSpaceBoundaries" Grid.Row="4" Grid.Column="2" Height="26"/>

                                            <CheckBox x:Name="chkIfcSplitWalls" Grid.Row="6" Grid.ColumnSpan="3"
                                                      Content="{x:Static l:L.ChkSplitWalls}" FontSize="11"/>
                                            <CheckBox x:Name="chkIfcSteelElements" Grid.Row="8" Grid.ColumnSpan="3"
                                                      Content="{x:Static l:L.ChkSteelElem}" IsChecked="True" FontSize="11"/>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="{x:Static l:L.GrpAdditional}" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Static l:L.LblLinkedFiles}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="comboIfcLinkedFiles" Grid.Column="2" Height="26"/>
                                            </Grid>
                                            <CheckBox x:Name="chkIfc2D" Content="{x:Static l:L.ChkExport2D}" FontSize="11" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="chkIfcVisibleOnly" Content="{x:Static l:L.ChkVisibleOnly}" FontSize="11" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="chkIfcRooms" Content="{x:Static l:L.ChkRooms}" FontSize="11"/>
                                        </StackPanel>
                                    </GroupBox>

                                </StackPanel>

                                <!-- RIGHT: Level of Detail + Property Sets -->
                                <StackPanel Grid.Column="2">

                                    <GroupBox Header="{x:Static l:L.GrpLOD}" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static l:L.LblTessellation}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="comboIfcTessellation" Grid.Column="2" Height="24" SelectedIndex="2">
                                                <ComboBoxItem Content="{x:Static l:L.TessExtraLow}"/>
                                                <ComboBoxItem Content="{x:Static l:L.TessLow}"/>
                                                <ComboBoxItem Content="{x:Static l:L.TessMedium}"/>
                                                <ComboBoxItem Content="{x:Static l:L.TessHigh}"/>
                                                <ComboBoxItem Content="{x:Static l:L.TessExtraHigh}"/>
                                            </ComboBox>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="{x:Static l:L.GrpPropSets}" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="chkIfcRevitPsets"     Content="{x:Static l:L.ChkRevitPsets}"  FontSize="11" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="chkIfcCommonPsets"    Content="{x:Static l:L.ChkCommonPsets}" FontSize="11" IsChecked="True" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="chkIfcBaseQty"        Content="{x:Static l:L.ChkBaseQty}"     FontSize="11" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="chkIfcSchedulesPsets" Content="{x:Static l:L.ChkSchedPsets}"  FontSize="11" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="chkIfcMaterialPsets"  Content="{x:Static l:L.ChkMatPsets}"    FontSize="11" Margin="0,0,0,10"/>

                                            <CheckBox x:Name="chkIfcUserPsets" Content="{x:Static l:L.ChkUserPsets}" FontSize="11" Margin="0,0,0,4"/>
                                            <Grid Margin="18,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtIfcUserPsetsFile" Height="24" FontSize="11"
                                                         VerticalContentAlignment="Center" Padding="4,0"/>
                                                <Button Grid.Column="2" Content="{x:Static l:L.BtnBrowse}" Height="24" Padding="8,0"
                                                        FontSize="11" Click="OnBrowseIfcUserPsets"/>
                                            </Grid>

                                            <CheckBox x:Name="chkIfcParamMapping" Content="{x:Static l:L.ChkParamMap}" FontSize="11" Margin="0,0,0,4"/>
                                            <Grid Margin="18,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtIfcParamMappingFile" Height="24" FontSize="11"
                                                         VerticalContentAlignment="Center" Padding="4,0"/>
                                                <Button Grid.Column="2" Content="{x:Static l:L.BtnBrowse}" Height="24" Padding="8,0"
                                                        FontSize="11" Click="OnBrowseIfcParamMapping"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>

                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- ── Advanced ── -->
                        <TabItem Header="{x:Static l:L.TabIfcAdvanced}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,12">
                                    <CheckBox x:Name="chkIfcParts"           Content="{x:Static l:L.ChkIfcParts}"    FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfcSolidModel"      Content="{x:Static l:L.ChkIfcSolid}"    FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfcActiveView"      Content="{x:Static l:L.ChkIfcActView}"  FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfcFamilyTypeName"  Content="{x:Static l:L.ChkIfcFamType}"  FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfc2DRoomBoundary"  Content="{x:Static l:L.ChkIfc2DRoom}"   FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfcSiteElevation"   Content="{x:Static l:L.ChkIfcSiteElev}" FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfcStoreGUID"       Content="{x:Static l:L.ChkIfcGUID}"     FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfcTriangulationOnly" Content="{x:Static l:L.ChkIfcTriangle}" FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfcTypeNameOnly"    Content="{x:Static l:L.ChkIfcTypeName}" FontSize="11" Margin="0,0,0,7"/>
                                    <CheckBox x:Name="chkIfcVisibleName"     Content="{x:Static l:L.ChkIfcVisName}"  FontSize="11" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static l:L.LblSitePlacement}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="comboIfcSitePlacement" Grid.Column="2" Height="26"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static l:L.LblExchangeReq}" Foreground="#5F6368" FontSize="11" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="comboIfcExchangeReq" Grid.Column="2" Height="26"/>
                                    </Grid>

                                    <!-- Import / Save settings -->
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="btnImportIfcSettings" Content="{x:Static l:L.BtnImportIfcSettings}"
                                                Width="140" Height="28" Margin="0,0,8,0"
                                                Click="OnImportIfcSettings"/>
                                        <Button x:Name="btnSaveIfcSettings" Content="{x:Static l:L.BtnSaveIfcSettings}"
                                                Width="140" Height="28"
                                                Click="OnSaveIfcSettings"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>

                </Grid>
            </Grid>
        </TabItem>

        <!-- TAB 3 — OUTPUT -->
        <TabItem Header="{x:Static l:L.TabOutput}">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Naming Profile -->
                <GroupBox Header="{x:Static l:L.GrpNamingProfile}">
                    <Grid Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="comboProfile" Height="28" SelectionChanged="OnProfileChanged"/>
                        <Button x:Name="btnEditProfiles" Content="{x:Static l:L.BtnEdit}" Grid.Column="2" Width="70" Height="28" Click="OnEditProfiles"/>
                        <Button x:Name="btnRefreshProfiles" Content="{x:Static l:L.BtnRefresh}" Grid.Column="4" Width="82" Height="28" Click="OnRefreshProfiles"/>

                        <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#F8F9FA" BorderBrush="#DDE1E7"
                                BorderThickness="1" CornerRadius="3" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static l:L.LblPreview}" Foreground="#AAA" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtPreview" Foreground="#1A73E8" FontFamily="Consolas" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Text="—"/>
                                <TextBlock x:Name="txtPreviewExt" Foreground="#5F6368" FontFamily="Consolas" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- Destination -->
                <GroupBox Header="{x:Static l:L.GrpDestination}" Grid.Row="2">
                    <Grid Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtFolder" Height="28" VerticalContentAlignment="Center"/>
                        <Button x:Name="btnBrowse" Content="{x:Static l:L.BtnBrowse}" Grid.Column="2" Width="80" Height="28" Click="OnBrowse"/>
                        <CheckBox x:Name="chkSubfolders" Grid.Row="2" Grid.ColumnSpan="3"
                                  Content="{x:Static l:L.ChkSubfolders}"/>
                        <CheckBox x:Name="chkProjectSubfolders" Grid.Row="4" Grid.ColumnSpan="3"
                                  Content="{x:Static l:L.ChkProjFolders}"/>
                    </Grid>
                </GroupBox>

                <!-- Progress -->
                <Grid Grid.Row="4">
                    <ProgressBar x:Name="progressBar" Style="{StaticResource BluePB}" Height="22" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="progressPct" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" FontWeight="Bold" Foreground="White" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="progressLabel" Grid.Row="6" HorizontalAlignment="Center"
                           FontSize="11" Foreground="#80868B"/>

                <!-- Buttons -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnExport" Content="{x:Static l:L.BtnExportSheets}" Height="36"
                            Style="{StaticResource PrimaryBtn}" Click="OnExport"/>
                    <Button x:Name="btnCancel" Grid.Column="2" Content="{x:Static l:L.BtnCancel}" Width="100" Height="36"
                            Background="#D93025" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                            Click="OnCancel"/>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
