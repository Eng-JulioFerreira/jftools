<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Uma base de código, uma compilação por faixa de Revit:
      dotnet build -c Release -p:RevitVersion=2022   → net48           (Revit 2022, 2023, 2024)
      dotnet build -c Release -p:RevitVersion=2025   → net8.0-windows  (Revit 2025, 2026)
      dotnet build -c Release -p:RevitVersion=2027   → net10.0-windows (Revit 2027)
    A API do Revit vem dos pacotes de referência Nice3point.Revit.Api (não é preciso ter o Revit instalado).
    Saída: bin\<Configuração>\R<RevitVersion>\JFTools.dll
  -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="$(RevitVersion) &lt; 2025">net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2025 And $(RevitVersion) &lt; 2027">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2027">net10.0-windows</TargetFramework>

    <OutputType>Library</OutputType>
    <RootNamespace>JFTools</RootNamespace>
    <AssemblyName>JFTools</AssemblyName>
    <Version>2.0.0</Version>
    <Product>JF Tools</Product>
    <Company>Eng. Júlio Ferreira</Company>
    <Copyright>Júlio Ferreira — GPL-3.0</Copyright>

    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <OutputPath>bin\$(Configuration)\R$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="EPPlus" Version="4.5.3" />
  </ItemGroup>

  <!-- EPPlus 4.5.3 (netstandard) puxa Newtonsoft.Json 11.0.2, que tem vulnerabilidade conhecida -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon16.png" />
    <EmbeddedResource Include="Resources\icon32.png" />
    <EmbeddedResource Include="Resources\impressora.png" />
    <EmbeddedResource Include="Resources\folhas-do-google.png" />
    <None Remove="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\JFTools.addin" Link="JFTools.addin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="export_profiles.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
